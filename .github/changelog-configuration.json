{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feat", "feature"]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["fix", "bug"]
    },
    {
      "title": "## 📝 Documentation",
      "labels": ["docs", "documentation"]
    },
    {
      "title": "## 🔧 Refactoring & Chore",
      "labels": ["refactor", "chore", "style"]
    },
    {
        "title": "## 🧪 Tests",
        "labels": ["test"]
    },
    {
        "title": "## 📦 Dependencies",
        "labels": ["dependencies"]
    },
    {
        "title": "## 💬 Other",
        "labels": []
    }
  ],
  "sort": "ASC",
  "template": "#{{CHANGELOG}}\n\n<details>\n<summary>Uncategorized</summary>\n\n#{{UNCATEGORIZED}}\n</details>",
  "pr_template": "- #{{TITLE}}\n   - PR: ##{{NUMBER}}",
  "empty_template": "No significant changes.",
  "label_extractor": [
{
      "pattern": "^(feat|feature|fix|bug|build|docs|ci|documentation|refactor|chore|style|test|dependencies)(?:\\([^)]+\\))?!?: (.+)",
      "target": "$1"
    }
  ]
}