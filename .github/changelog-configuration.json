{
   "categories":[
      {
         "title":"## 💥 Breaking Changes",
         "labels":[
            "breaking"
         ]
      },
      {
         "title":"## 🚀 Features",
         "labels":[
            "feat",
            "feature"
         ]
      },
      {
         "title":"## 🐛 Bug Fixes",
         "labels":[
            "fix",
            "bug"
         ]
      },
      {
         "title":"## ⚡ Performance Improvements",
         "labels":[
            "perf"
         ]
      },
      {
         "title":"## ♻️ Refactoring & Code Quality",
         "labels":[
            "refactor",
            "style",
            "chore"
         ]
      },
      {
         "title":"## 📝 Documentation",
         "labels":[
            "docs",
            "doc"
         ]
      },
      {
         "title":"## 🧪 Tests",
         "labels":[
            "test"
         ]
      },
      {
         "title":"## ⚙️ Build System & CI/CD",
         "labels":[
            "build",
            "ci"
         ]
      },
      {
         "title":"## 💬 Other",
         "labels":[
            
         ]
      }
   ],
   "sort":"ASC",
   "template":"#{{CHANGELOG}}\n\n## CONTRIBUTORS\n\n#{{CONTRIBUTORS}}",
   "pr_template":"- #{{TITLE}}. PR(##{{NUMBER}}) by @#{{AUTHOR}}",
   "empty_template":"No significant changes.",
   "label_extractor":[
      {
         "pattern":"^(\\w+)(?:\\([^)]+\\))?!?: ([\\w ])+([\\s\\S]*)",
         "target":"$1",
         "on_property":"title"
      },
      {
         "pattern":"^\\w+(?:\\([^)]+\\))?!: ([\\w ])+([\\s\\S]*)",
         "target":"breaking",
         "on_property":"title"
      }
   ]
}